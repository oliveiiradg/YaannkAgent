[Unit]
Description=Yaannk - Gateway FastAPI (uvicorn)
After=network-online.target yaannk-evolution.service yaannk-ollama.service
Wants=network-online.target yaannk-ollama.service
Requires=yaannk-evolution.service

[Service]
Type=simple
WorkingDirectory=%h/YaannkAgent/gateway
# Sem --host/--port aqui: o entrypoint usa WEBHOOK_HOST/WEBHOOK_PORT do .env
# (default 127.0.0.1:5000). Ajuste WEBHOOK_HOST no .env se a Evolution API
# precisar alcançar o gateway por outra interface (ex: bridge do Docker).
ExecStart=%h/YaannkAgent/gateway/venv/bin/python3 -m app.main
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
