EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
WEBHOOK_PORT=5000
# Segredo compartilhado para autenticar o webhook. Se preenchido, o gateway
# exige o header `X-Webhook-Secret` com esse valor — configure o MESMO valor
# nos headers do webhook da Evolution API. Vazio = sem autenticação.
WEBHOOK_SECRET=
# Números autorizados a falar com o Yaannk, separados por vírgula (DDI+DDD+número, sem @s.whatsapp.net)
ALLOWED_NUMBERS=5521999999999,5521888888888
# Nomes conhecidos: pares numero:Nome, separados por vírgula. Yaannk usa o nome
# na resposta ("Anotado, Alice!") e no campo "Registrou" do vault.
KNOWN_NAMES=5521999999999:Fulano,5521888888888:Ciclana
# Nomes usados nos prompts do assistente. Vazios → fraseado genérico
# ("o usuário" / "o casal"). Não confundir com KNOWN_NAMES (que é por número).
OWNER_NAME=
PARTNER_NAME=
# Stopwords extras do TF-IDF (csv) — nomes próprios / termos que aparecem em
# quase todo arquivo do vault e não ajudam a discriminar.
EXTRA_STOPWORDS=
# Número do próprio Yaannk (só dígitos) — detecta menção via contato nos grupos.
# Se vazio, cai no campo `sender` do webhook da Evolution.
YAANNK_NUMBER=
# LID do Yaannk (só dígitos) — em grupo a menção via contato chega como
# `<lid>@lid` em mentionedJid, não como o número. Ver log "Payload cru".
YAANNK_LID=
# Nó Ollama primário (ex: desktop com GPU na LAN). Deixe vazio para usar só o
# nó local (OLLAMA_URL). Ex: http://192.168.1.100:11434
OLLAMA_DESKTOP_URL=
# Nó de fallback, usado se o desktop não responder — normalmente o próprio
# notebook onde o Gateway roda.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Provider de LLM default (Fase 2 Multi-LLM). Valores: ollama (único por ora).
# Fase 3 adiciona: kimi.
LLM_DEFAULT_PROVIDER=ollama
# Telemetria de LLM — grava tabela llm_calls (provider, tokens, latência, custo).
LLM_TELEMETRY=true
# LLM Router determinístico (Fase 5). false = Bloco 3 sempre no provider default.
LLM_ROUTER_ENABLED=false
# Kimi via OpenRouter (API compatível com OpenAI). Sem KIMI_API_KEY o provider
# não é registrado. KimiProvider envia os headers HTTP-Referer / X-Title.
KIMI_API_KEY=
KIMI_BASE_URL=https://openrouter.ai/api/v1
KIMI_MODEL_TIER1=moonshotai/kimi-k2.6
KIMI_MODEL_TIER2=moonshotai/kimi-k2.7-code
KIMI_MIN_MAX_TOKENS=1000
KIMI_PRICE_IN_PER_MTOK=0.95
KIMI_PRICE_OUT_PER_MTOK=4.00
# Caminho local do vault do Obsidian (sincronizado via OneDrive)
VAULT_PATH=/home/user/OneDrive/Documents/Vault
# MCP Connector do Obsidian (busca semântica via search_vault_smart).
# Token fica em .obsidian/plugins/mcp-tools-istefox/data.json dentro do vault.
# Se ausente/inválido, o Bloco 2 cai automaticamente no fallback TF-IDF.
OBSIDIAN_MCP_URL=http://127.0.0.1:27200/mcp
OBSIDIAN_MCP_TOKEN=
